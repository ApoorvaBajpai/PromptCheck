# Environment Configuration for PromptCheck

# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=True

# Backend Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=promptcheck
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/promptcheck

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security Secrets (IMPORTANT: In production, generate strong unique keys!)
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-secure-random-32-char-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=t8ugVmp3vGlAT11bNiEaJELvyj-1f8qZkaQTDH1Au0E=

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
PORT=3000

# CLI Configuration
PROMPTCHECK_API_URL=http://localhost:8000
